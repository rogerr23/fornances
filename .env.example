# Neon, string POOLED (host com -pooler) — usada pela app
DATABASE_URL=
# Neon, string direta — usada pelo drizzle-kit nas migrations e pelo script de criar usuário
DATABASE_URL_UNPOOLED=
# Gerar com: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Gerar com: openssl rand -base64 32 — protege a rota do cron das recorrentes
CRON_SECRET=
